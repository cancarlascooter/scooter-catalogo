{
  "name": "ropa-accesorios-pruebas",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ropa-accesorios-pruebas",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ropa-accesorios-pruebas",
      "remote": false
    }
  ],
  "vars": {
    "AUTH_MODE": "password"
  }
}
